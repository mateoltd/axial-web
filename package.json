{
  "name": "axial-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "pnpm --filter axial-web... run build && wrangler dev",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-types": "wrangler types",
    "deploy": "pnpm --filter axial-web... run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/react": "^6.0.1",
    "@openai/apps-sdk-ui": "^0.2.2",
    "astro": "^7.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.8.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.114.0"
  }
}
