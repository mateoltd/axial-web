---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from './Icon';
import type { Locale } from '../i18n/ui';
import { locales, ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];

const githubUrl = 'https://github.com/mateoltd/axial';
const releasesUrl = 'https://github.com/mateoltd/axial/releases';
const rel = 'https://github.com/mateoltd/axial/releases/download/v0.4.0-dev.5';

const downloads = [
  {
    id: 'macos',
    platform: 'macOS',
    detail: copy.downloads.activeDev,
    builds: [
      {
        label: 'Apple Silicon',
        build: 'macos-arm64',
        url: `${rel}/axial-macos-arm64-0.4.0-dev.5.dmg`,
      },
      {
        label: 'Intel',
        build: 'macos-amd64',
        url: `${rel}/axial-macos-amd64-0.4.0-dev.5.dmg`,
      },
    ],
  },
  {
    id: 'linux',
    platform: 'Linux',
    detail: copy.downloads.activeDev,
    builds: [
      {
        label: 'x64',
        build: 'linux-amd64',
        url: `${rel}/axial-linux-amd64-0.4.0-dev.5`,
      },
    ],
  },
  {
    id: 'windows',
    platform: 'Windows',
    detail: copy.downloads.earlyAlpha,
    builds: [
      {
        label: 'x64',
        build: 'windows-amd64',
        url: `${rel}/axial-windows-amd64-0.4.0-dev.5.exe`,
      },
    ],
  },
];
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  lang={locale}
  ogLocale={copy.meta.ogLocale}
  ogImageAlt={copy.meta.ogImageAlt}
>
  <header class="site-header">
    <nav class="site-nav" aria-label={copy.nav.ariaLabel}>
      <a class="brand" href="#top" aria-label={copy.nav.homeAriaLabel}>
        <img src="/logo.png" width="34" height="34" alt="" />
        <span>Axial</span>
      </a>

      <div class="nav-links">
        <a href="#downloads">{copy.nav.downloads}</a>
        <a href={githubUrl}>GitHub</a>
      </div>

      <div class="nav-actions">
        <div
          class="locale-switcher"
          role="group"
          aria-label={copy.nav.languageAriaLabel}
        >
          {
            locales.map((item) => (
              <a
                class="locale-link"
                href={getRelativeLocaleUrl(item, '')}
                lang={item}
                hreflang={item}
                aria-current={item === locale ? 'page' : undefined}
                title={ui[item].languageName}
              >
                {item.toUpperCase()}
              </a>
            ))
          }
        </div>
        <a class="cp-btn cp-btn--secondary" href="#downloads">
          <Icon name="download" size={16} />
          <span>{copy.nav.download}</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="top" class="shell">
    <section class="hero">
      <h1>{copy.hero.title[0]} <br />{copy.hero.title[1]}</h1>
      <p class="hero-sub">{copy.hero.description}</p>
      <div class="hero-actions">
        <a
          class="cp-btn cp-btn--primary cp-btn--lg"
          id="hero-download"
          href="#downloads"
          data-mac-label={copy.downloads.platformLabels.mac}
          data-win-label={copy.downloads.platformLabels.win}
          data-linux-label={copy.downloads.platformLabels.linux}
        >
          <Icon name="download" size={18} />
          <span id="hero-download-label">{copy.hero.download}</span>
        </a>
        <a class="hero-alt" href="#downloads">{copy.hero.allPlatforms}</a>
      </div>
    </section>

    <section class="bleed" aria-label={copy.screenshot.ariaLabel}>
      <div class="bleed-inner">
        <picture>
          <source
            media="(max-width: 760px)"
            srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
          />
          <img
            src="/images/launcher-home.jpg"
            width="2560"
            height="1600"
            alt={copy.screenshot.alt}
          />
        </picture>
        <div class="bleed-fade" aria-hidden="true"></div>
      </div>
      <div class="bleed-mobile" aria-hidden="true">
        <div class="bm-greeting">
          <span class="bm-hello">{copy.screenshot.mobileArt.greeting}</span>
          <span class="bm-tally">{copy.screenshot.mobileArt.tally}</span>
        </div>
        <div class="bm-resume">
          <div class="bm-resume-info">
            <span class="bm-kicker">{copy.screenshot.mobileArt.kicker}</span>
            <span class="bm-name">{copy.screenshot.mobileArt.instanceName}</span>
            <span class="bm-detail">{copy.screenshot.mobileArt.instanceDetail}</span>
          </div>
          <span class="bm-play">
            <Icon name="play" size={14} />
            <span>{copy.screenshot.mobileArt.play}</span>
          </span>
        </div>
        <div class="bm-library">
          <span class="bm-heading">{copy.screenshot.mobileArt.library}</span>
          <div class="bm-cards">
            {
              copy.screenshot.mobileArt.cards.map((card) => (
                <div class="bm-card">
                  <img
                    class="bm-cover"
                    src={`/images/covers/${card.image}.png`}
                    width="428"
                    height="259"
                    alt=""
                    loading="lazy"
                  />
                  <span class="bm-card-name">{card.name}</span>
                  <span class="bm-card-detail">{card.detail}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="ethos" aria-label={copy.ethos.ariaLabel}>
      <p>
        {
          copy.ethos.parts.map(([text, emphasized]) =>
            emphasized ? <em>{text}</em> : text,
          )
        }
      </p>
    </section>

    <section class="features" aria-label={copy.features.ariaLabel}>
      <article class="feature">
        <div class="feature-art" aria-hidden="true">
          <div class="art-instances">
            {
              copy.features.versions.art.cards.map((card, index) => (
                <div class={`art-instance art-instance--${index}`}>
                  <img
                    class="art-cover"
                    src={`/images/covers/${card.image}.png`}
                    width="428"
                    height="259"
                    alt=""
                    loading="lazy"
                  />
                  <span class="art-instance-name">{card.name}</span>
                  <span class="art-instance-detail">{card.detail}</span>
                </div>
              ))
            }
          </div>
        </div>
        <h3>{copy.features.versions.title}</h3>
        <p>{copy.features.versions.body}</p>
      </article>

      <article class="feature">
        <div class="feature-art" aria-hidden="true">
          <div class="art-panel">
            <span class="art-panel-heading">{copy.features.modded.art.heading}</span>
            <div class="art-line">
              <span class="art-check">
                <Icon name="check" size={13} />
              </span>
              <span>{copy.features.modded.art.stageJava}</span>
            </div>
            <div class="art-line">
              <span class="art-check">
                <Icon name="check" size={13} />
              </span>
              <span>{copy.features.modded.art.stageLibraries}</span>
            </div>
            <div class="art-progress">
              <span class="art-progress-label">
                {copy.features.modded.art.stageAssets}
              </span>
              <span class="art-progress-track">
                <span class="art-progress-fill"></span>
              </span>
            </div>
          </div>
        </div>
        <h3>{copy.features.modded.title}</h3>
        <p>{copy.features.modded.body}</p>
      </article>

      <article class="feature">
        <div class="feature-art" aria-hidden="true">
          <div class="art-panel">
            <div class="art-line art-line--dim">
              <span class="art-warn">!</span>
              <span>{copy.features.guardian.art.failed}</span>
            </div>
            <div class="art-line">
              <span class="art-shield">
                <Icon name="shield" size={13} />
              </span>
              <span>{copy.features.guardian.art.repaired}</span>
            </div>
            <div class="art-line art-line--strong">
              <span class="art-check">
                <Icon name="check" size={13} />
              </span>
              <span>{copy.features.guardian.art.relaunched}</span>
            </div>
          </div>
        </div>
        <h3>{copy.features.guardian.title}</h3>
        <p>{copy.features.guardian.body}</p>
      </article>

      <article class="feature">
        <div class="feature-art" aria-hidden="true">
          <div class="art-runtime">
            <div class="art-row art-row--picked">
              <span class="art-check">
                <Icon name="check" size={13} />
              </span>
              <span class="art-row-name">
                {copy.features.performance.art.picked}
              </span>
              <span class="art-row-tag">
                {copy.features.performance.art.pickedTag}
              </span>
            </div>
            <div class="art-row art-row--dim">
              <span class="art-dot"></span>
              <span class="art-row-name">
                {copy.features.performance.art.rejected}
              </span>
              <span class="art-row-tag">
                {copy.features.performance.art.rejectedTag}
              </span>
            </div>
          </div>
        </div>
        <h3>{copy.features.performance.title}</h3>
        <p>{copy.features.performance.body}</p>
      </article>
    </section>

    <section id="downloads" class="downloads">
      <h2>{copy.downloads.heading}</h2>
      <p class="notice-line" role="note">{copy.downloads.notice}</p>

      <div class="download-list">
        {
          downloads.map((download) => (
            <div class="download-row" id={`download-${download.id}`}>
              <div class="dl-id">
                <span class="dl-platform">{download.platform}</span>
                <span class="dl-detail">{download.detail}</span>
              </div>
              <div class="dl-links">
                {download.builds.map((build) => (
                  <a
                    class="dl-link"
                    href={build.url}
                    data-build={build.build}
                    download
                  >
                    <Icon name="download" size={15} />
                    <span>{build.label}</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="download-fineprint">
        {copy.downloads.fineprintBefore}<a href={releasesUrl}
          >{copy.downloads.releasesArchive}</a
        >{copy.downloads.fineprintAfter}
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-top">
      <a class="brand brand-small" href="#top">
        <img src="/logo.png" width="28" height="28" alt="" />
        <span>Axial</span>
      </a>
      <div class="footer-links">
        <a href="#downloads">{copy.nav.downloads}</a>
        <a href={githubUrl}>GitHub</a>
        <a href={releasesUrl}>{copy.footer.releases}</a>
      </div>
    </div>
    <div class="footer-wordmark" aria-hidden="true">Axial</div>
  </footer>

  <script>
    const button = document.querySelector<HTMLAnchorElement>('#hero-download');
    const label = document.querySelector<HTMLElement>('#hero-download-label');
    const ua = navigator.userAgent;
    const platform = /Mac/i.test(ua)
      ? 'mac'
      : /Win/i.test(ua)
        ? 'win'
        : /Linux|X11/i.test(ua)
          ? 'linux'
          : null;

    if (platform && button && label) {
      const platformLabel = button.dataset[`${platform}Label`];
      if (platformLabel) {
        label.textContent = platformLabel;
        button.href = `#download-${platform === 'mac' ? 'macos' : platform === 'win' ? 'windows' : 'linux'}`;
      }
    }

    interface ReleaseAsset {
      name: string;
      browser_download_url: string;
    }

    const buildMatchers: Record<string, (name: string) => boolean> = {
      'macos-arm64': (name) => /^axial-macos-arm64-.+\.dmg$/.test(name),
      'macos-amd64': (name) => /^axial-macos-amd64-.+\.dmg$/.test(name),
      'linux-amd64': (name) =>
        name.startsWith('axial-linux-amd64-') &&
        !/\.(sha256|tar\.gz|zip)$/.test(name),
      'windows-amd64': (name) => /^axial-windows-amd64-.+\.exe$/.test(name),
    };

    fetch('https://api.github.com/repos/mateoltd/axial/releases?per_page=1')
      .then((response) => (response.ok ? response.json() : Promise.reject()))
      .then(([release]) => {
        if (!release?.assets) return;
        const assets: ReleaseAsset[] = release.assets;
        for (const [build, matches] of Object.entries(buildMatchers)) {
          const asset = assets.find((candidate) => matches(candidate.name));
          if (!asset) continue;
          for (const link of document.querySelectorAll<HTMLAnchorElement>(
            `[data-build="${build}"]`,
          )) {
            link.href = asset.browser_download_url;
          }
        }
      })
      .catch(() => {});

    const wordmark = document.querySelector<HTMLElement>('.footer-wordmark');
    wordmark?.addEventListener('pointermove', (event) => {
      const rect = wordmark.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      wordmark.style.setProperty('--wm-x', `${x}px`);
      wordmark.style.setProperty('--wm-y', `${y}px`);
      wordmark.style.setProperty(
        '--wm-shift',
        `${(x - rect.width / 2) * -0.18}px`,
      );
    });
  </script>
</BaseLayout>
